{
  "description": "Way of Work guardrails: no secrets in files or commits, no direct commits/pushes to environment branches, conventional commit messages.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\"", "timeout": 30 }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\"", "timeout": 30 }
        ]
      }
    ]
  }
}
