# Copy to .env (git-ignored) for local development. Placeholders only — never real values.
# Real values come from the secret store / vault at deploy time or runtime (§6.2).
APP_ENV=local
DATABASE_URL=postgres://app:<password>@localhost:5432/app
OPENAI_API_KEY=<from-vault>
ANTHROPIC_API_KEY=<from-vault>
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
# Prefer Managed Identity for Azure OpenAI so no key is needed at all.
