{
  "name": "Way of Work: only the repository lead promotes",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["refs/heads/staging", "refs/heads/demo", "refs/heads/prod"],
      "exclude": []
    }
  },
  "rules": [
    { "type": "update" }
  ],
  "bypass_actors": [
    { "actor_type": "Team", "actor_id": 0, "bypass_mode": "pull_request" }
  ]
}
